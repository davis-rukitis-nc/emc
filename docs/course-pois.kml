				<Placemark id="5DB74C128800002F">
					<name>Mežaparks Great Bandstand</name>
					<description><![CDATA[<div><b>The Mežaparks Grand Bandstand</b> is where Latvia sings at full volume. Since 1955, it has been the home of the Latvian Song Celebration – every five years, choirs, dancers and audiences gather here, turning Mežaparks into one huge shared moment.</div>]]></description>
					<LookAt>
						<longitude>24.10286969201809</longitude>
						<latitude>56.94753289055387</latitude>
						<altitude>3.291261135461871</altitude>
						<heading>-38.70981903806845</heading>
						<tilt>0.1172150915609462</tilt>
						<gx:fovy>35</gx:fovy>
						<range>327.1422657922085</range>
						<altitudeMode>absolute</altitudeMode>
					</LookAt>
					<styleUrl>#__managed_style_091BC55B3240D99CBAB7</styleUrl>
					<Point>
						<coordinates>24.15219830848193,57.01483832149056,3.291208175269781</coordinates>
					</Point>
				</Placemark>
				<Placemark id="5DB74C1288000030">
					<name>ZOO</name>
					<description><![CDATA[<div><b>Riga Zoo</b> has been part of Mežaparks since 1912. A great stop for nature lovers, families and anyone who wants to meet Riga’s calmer side before or after the run.</div>]]></description>
					<LookAt>
						<longitude>24.15671150559756</longitude>
						<latitude>57.00492527073681</latitude>
						<altitude>9.442987352462955</altitude>
						<heading>333.8068299403488</heading>
						<tilt>0</tilt>
						<gx:fovy>35</gx:fovy>
						<range>1074.481150390202</range>
						<altitudeMode>absolute</altitudeMode>
					</LookAt>
					<styleUrl>#__managed_style_033AF1474A40D99CBABF</styleUrl>
					<Point>
						<coordinates>24.15712984243924,57.00574133154794,9.442040614583442</coordinates>
					</Point>
				</Placemark>
				<Placemark id="5DB74C1288000031">
					<name>Freedom Monument</name>
					<description><![CDATA[<div><b>The Freedom Monument</b> is one of Latvia’s strongest symbols of independence – a place where Riga’s heart beats especially loud.</div><div>In 2023, two world records were set at the foot of the monument during the World Athletics Road Running Championships Riga23. <b>The women’s road mile world record, 4:20.98, still stands today.</b></div>]]></description>
					<LookAt>
						<longitude>24.10286969201809</longitude>
						<latitude>56.94753289055387</latitude>
						<altitude>3.291261135461871</altitude>
						<heading>-38.70981903806845</heading>
						<tilt>0.1172150915609462</tilt>
						<gx:fovy>35</gx:fovy>
						<range>327.1422657922085</range>
						<altitudeMode>absolute</altitudeMode>
					</LookAt>
					<styleUrl>#__managed_style_091BC55B3240D99CBAB7</styleUrl>
					<Point>
						<coordinates>24.11332557419026,56.95153742823825,3.291208175269781</coordinates>
					</Point>
				</Placemark>
				<Placemark id="5DB74C1288000032">
					<name>Latvian National Museum of Art</name>
					<description><![CDATA[<div><b>The Latvian National Museum of Art</b> is one of Riga’s key cultural stops. Its main building, opened in 1905, was the first purpose-built art museum building in the Baltics.</div>]]></description>
					<LookAt>
						<longitude>24.10286969201809</longitude>
						<latitude>56.94753289055387</latitude>
						<altitude>3.291261135461871</altitude>
						<heading>-38.70981903806845</heading>
						<tilt>0.1172150915609462</tilt>
						<gx:fovy>35</gx:fovy>
						<range>327.1422657922085</range>
						<altitudeMode>absolute</altitudeMode>
					</LookAt>
					<styleUrl>#__managed_style_091BC55B3240D99CBAB7</styleUrl>
					<Point>
						<coordinates>24.11347522269941,56.95572199975129,3.291208175269781</coordinates>
					</Point>
				</Placemark>
				<Placemark id="5DB74C1288000033">
					<name>Riga Castle</name>
					<description><![CDATA[<div><b>Riga Castle,</b> on the bank of the Daugava, is the official residence of the President of Latvia and one of Riga’s oldest landmarks.</div><div>Look up at the tower — if the white President’s flag is flying, the President is working in the Castle. Spot it on race day as you head down the finish straight!</div>]]></description>
					<LookAt>
						<longitude>24.10286969201809</longitude>
						<latitude>56.94753289055387</latitude>
						<altitude>3.291261135461871</altitude>
						<heading>-38.70981903806845</heading>
						<tilt>0.1172150915609462</tilt>
						<gx:fovy>35</gx:fovy>
						<range>327.1422657922085</range>
						<altitudeMode>absolute</altitudeMode>
					</LookAt>
					<styleUrl>#__managed_style_091BC55B3240D99CBAB7</styleUrl>
					<Point>
						<coordinates>24.10046691936089,56.95116924015894,3.291208175269781</coordinates>
					</Point>
				</Placemark>
				<Placemark id="5DB74C1288000034">
					<name>Vanšu Bridge</name>
					<description><![CDATA[<div><b>Vanšu Bridge</b> is one of Riga’s most recognisable lines across the Daugava – with its tall pylon, cables and wide views towards Ķīpsala.</div><div>It connects the city centre with Pārdaugava and is one of those spots where Riga looks especially photogenic on marathon day.</div>]]></description>
					<LookAt>
						<longitude>24.10286969201809</longitude>
						<latitude>56.94753289055387</latitude>
						<altitude>3.291261135461871</altitude>
						<heading>-38.70981903806845</heading>
						<tilt>0.1172150915609462</tilt>
						<gx:fovy>35</gx:fovy>
						<range>327.1422657922085</range>
						<altitudeMode>absolute</altitudeMode>
					</LookAt>
					<styleUrl>#__managed_style_091BC55B3240D99CBAB7</styleUrl>
					<Point>
						<coordinates>24.09353585916876,56.95075260250155,3.291208175269781</coordinates>
					</Point>
				</Placemark>
				<Placemark id="5DB74C1288000035">
					<name>Botanical Garden</name>
					<description><![CDATA[<div><b>The University of Latvia Botanical Garden</b> is a peaceful green stop in Pārdaugava and the oldest botanical garden in Latvia.</div><div>Since 1922, it has been home to plants from all over the world – from seasonal blooms to tropical greenhouses.</div>]]></description>
					<LookAt>
						<longitude>24.10286969201809</longitude>
						<latitude>56.94753289055387</latitude>
						<altitude>3.291261135461871</altitude>
						<heading>-38.70981903806845</heading>
						<tilt>0.1172150915609462</tilt>
						<gx:fovy>35</gx:fovy>
						<range>327.1422657922085</range>
						<altitudeMode>absolute</altitudeMode>
					</LookAt>
					<styleUrl>#__managed_style_091BC55B3240D99CBAB7</styleUrl>
					<Point>
						<coordinates>24.06326508106818,56.95106408175248,3.291208175269781</coordinates>
					</Point>
				</Placemark>
				<Placemark id="5DB74C1288000036">
					<name>Stone Bridge</name>
					<description><![CDATA[<div><b>The Stone Bridge</b> is one of Riga’s classic views — across the Daugava towards Old Riga and its skyline of church towers. </div><div>Long before today’s bridge, this crossing was home to earlier raft and pontoon bridges. The current bridge opened in 1957.</div>]]></description>
					<LookAt>
						<longitude>24.10286969201809</longitude>
						<latitude>56.94753289055387</latitude>
						<altitude>3.291261135461871</altitude>
